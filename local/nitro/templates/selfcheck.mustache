{{!
    @template local_nitro/selfcheck

    Results of the discovery self-check, with the optional rewrite rules.

    Example context (json):
    {
        "rows": [{"url": "https://moodle.example/local/nitro/oauth/metadata.php/.well-known/openid-configuration",
                  "label": "Authorization server metadata (plugin)", "ok": true, "status": "200"}],
        "pluginok": true,
        "rootmissing": true,
        "rules": [{"name": "Apache (virtual host)", "rule": "RewriteRule ..."}]
    }
}}
<table class="table table-sm local_nitro-selfcheck" id="local_nitro_selfcheck">
    <tbody>
    {{#rows}}
        <tr>
            <td>{{#ok}}{{#pix}} i/valid, core, {{#str}} selfcheckok, local_nitro {{/str}} {{/pix}}{{/ok}}{{^ok}}{{#pix}} i/invalid, core, {{#str}} selfcheckmissing, local_nitro {{/str}} {{/pix}}{{/ok}}</td>
            <td>{{label}}<br><code class="small">{{url}}</code></td>
            <td class="small">{{#ok}}{{#str}} selfcheckok, local_nitro {{/str}}{{/ok}}{{^ok}}{{#str}} selfcheckmissing, local_nitro {{/str}} ({{status}}){{/ok}}</td>
        </tr>
    {{/rows}}
    </tbody>
</table>
{{^pluginok}}
<div class="alert alert-danger">{{#str}} selfcheckpluginbroken, local_nitro {{/str}}</div>
{{/pluginok}}
{{#rootmissing}}
<p>{{#str}} selfcheckrootoptional, local_nitro {{/str}}</p>
{{#rules}}
<p class="mb-1"><strong>{{name}}</strong></p>
<pre class="small bg-light p-2">{{rule}}</pre>
{{/rules}}
{{/rootmissing}}
