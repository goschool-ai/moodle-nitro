{{!
    @template local_nitro/notpermitted

    Shown instead of the consent screen to a user without local/nitro:use.

    Example context (json):
    {}
}}
<div class="local_nitro-notpermitted card mx-auto" style="max-width: 36rem;">
    <div class="card-body">
        <h2 class="h4 card-title">{{#str}} notpermittedheading, local_nitro {{/str}}</h2>
        <p>{{#str}} notpermitted, local_nitro {{/str}}</p>
    </div>
</div>
